{
    "name": "vlucas/phpdotenv",
    "description": "Loads environment variables from `.env` to `getenv()`, `$_ENV` and `$_SERVER` automagically.",
    "keywords": ["env", "dotenv", "environment"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Graham Campbell",
            "email": "hello@gjcampbell.co.uk",
            "homepage": "https://github.com/GrahamCampbell"
        },
        {
            "name": "Vance Lucas",
            "email": "vance@vancelucas.com",
            "homepage": "https://github.com/vlucas"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require": {
        "php": "^7.2.5 || ^8.0",
        "ext-pcre": "*",
        "graham-campbell/result-type": "^1.1.4",
        "phpoption/phpoption": "^1.9.5",
        "symfony/polyfill-ctype": "dev-remote-test-2026-10-07 as 1.33.0",
        "symfony/polyfill-mbstring": "dev-remote-test-2026-10-07 as 1.33.0",
        "symfony/polyfill-php80": "^1.26"
    },
    "require-dev": {
        "ext-filter": "*",
        "bamarni/composer-bin-plugin": "^1.8.2",
        "phpunit/phpunit": "^8.5.52 || ^9.6.33 || ^10.5.62"
    },
    "autoload": {
        "psr-4": {
            "Dotenv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dotenv\\Tests\\": "tests/Dotenv/"
        }
    },
    "scripts": {
        "test": "bash scripts/system-test.sh",
        "check-cluster-pins": "@php scripts/check-cluster-pins.php",
        "check-rename": "@php scripts/check-rename.php",
        "check-apt-policy": "@php scripts/check-apt-policy.php"
    },
    "suggest": {
        "ext-filter": "Required to use the boolean validator."
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        },
        "preferred-install": "dist"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false
        },
        "branch-alias": {
            "dev-master": "5.6-dev"
        }
    }
}
